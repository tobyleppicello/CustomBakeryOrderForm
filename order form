<script>
(function () {
  "use strict";

  const MENU = window.BAKERY_MENU;
  const brand = MENU.brand;

  /* ---------- Tiny DOM helpers ---------- */
  const $ = (sel, root = document) => root.querySelector(sel);
  const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
  const esc = (str) => String(str)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

  function optionsHtml(list, mapFn) {
    return list.map(mapFn).join("");
  }

  function cardShell(inner) {
    return `<div class="bg-white p-3 rounded-lg border border-gray-200 shadow-sm" style="border-width: 1px !important;">${inner}</div>`;
  }

  function itemToggle(id, label) {
    return `
      <label class="flex items-center space-x-3 cursor-pointer">
        <input type="checkbox" class="form-checkbox h-5 w-5 text-[#4e8ea1] rounded" onchange="toggleVisibility('sub-${id}', this.checked)">
        <span class="font-semibold text-gray-700">${esc(label)}</span>
      </label>`;
  }

  function flavorQtyRows(options, qtyClass, layout) {
    if (layout === "grid") {
      return `
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2 text-sm">
          ${options.map((o) => `
            <div class="flex items-center justify-between bg-gray-50 p-2 rounded">
              <span class="w-24 text-gray-600">${esc(o.label)}</span>
              <input type="number" min="0" class="p-1 w-16 rounded ${qtyClass} border-gray-300" data-flavor="${esc(o.flavor)}">
            </div>`).join("")}
        </div>`;
    }
    return options.map((o) => `
      <div class="flex justify-between items-center text-gray-600">
        ${esc(o.label)}
        <input type="number" min="0" class="p-1 w-16 rounded ${qtyClass} border-gray-300" data-flavor="${esc(o.flavor)}">
      </div>`).join("");
  }

  /* ---------- Render category toggles ---------- */
  function renderCategories() {
    $("#category-toggles").innerHTML = MENU.categories.map((cat) => `
      <label class="cursor-pointer relative">
        <input type="checkbox" id="cat-${cat.id}" class="custom-checkbox opacity-0 absolute w-0 h-0 -z-10" onchange="toggleSection('${cat.sectionId}', this.checked)">
        <div class="rounded-xl p-4 flex items-center transition-all duration-200" style="border-width: 2px !important; border-color: #e5e7eb !important;">
          <i class="fas ${cat.icon} text-2xl text-[#852c51] mr-3"></i>
          <span class="font-bold text-gray-700">${esc(cat.label)}</span>
        </div>
      </label>`).join("");
  }

  /* ---------- Pastries ---------- */
  function renderPastries() {
    const p = MENU.pastries;

    const simpleGrid = `
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        ${p.simple.map((item) => cardShell(`
          ${itemToggle(item.id, item.name)}
          <div id="sub-${item.id}" class="hidden mt-3 pl-8">
            <div class="flex items-center space-x-2">
              <span class="text-sm text-gray-500">Qty:</span>
              <input type="number" min="1" class="p-1 w-20 rounded item-qty focus:ring-[#4e8ea1]" data-name="${esc(item.name)}">
            </div>
          </div>`)).join("")}
      </div>`;

    const donut = p.yeastDonuts;
    const yeastBlock = cardShell(`
      ${itemToggle(donut.id, donut.name)}
      <div id="sub-${donut.id}" class="hidden mt-4 pl-8 border-[#4e8ea1] ml-2 space-y-4" style="border-left-width: 2px !important;">
        ${donut.groups.map((g) => `
          <div>
            <h4 class="text-sm font-bold text-[#852c51] mb-2" style="margin-top:0;">${esc(g.heading)}</h4>
            ${flavorQtyRows(g.options, "donut-qty", "grid")}
          </div>`).join("")}
      </div>`);

    const cup = p.cupcakes;
    const cupcakesBlock = cardShell(`
      ${itemToggle(cup.id, cup.name)}
      <div id="sub-${cup.id}" class="hidden mt-4 pl-8 border-[#4e8ea1] ml-2" style="border-left-width: 2px !important;">
        <p class="text-xs text-gray-400 mb-3" style="margin:0;">${esc(cup.hint)}</p>
        <div id="cupcake-batches" class="space-y-3 mb-3"></div>
        <button type="button" onclick="addCupcakeBatch()" class="text-sm bg-[#fdf2f0] hover:bg-[#4e8ea1] hover:text-white text-[#4e8ea1] py-1.5 px-3 rounded-full font-bold transition cursor-pointer" style="border-width:0 !important;"><i class="fas fa-plus mr-1"></i> Add Cupcake Batch</button>
      </div>`);

    const flavorCards = `
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        ${p.flavorCards.map((card) => cardShell(`
          <label class="flex items-center space-x-3 cursor-pointer">
            <input type="checkbox" class="form-checkbox h-5 w-5 text-[#4e8ea1] rounded" onchange="toggleVisibility('sub-${card.id}', this.checked)">
            <span class="font-semibold text-gray-700">${esc(card.name)}</span>
          </label>
          <div id="sub-${card.id}" class="hidden mt-2 space-y-2 pl-8 text-sm">
            ${flavorQtyRows(card.options, card.qtyClass)}
          </div>`)).join("")}
      </div>`;

    const cookies = p.cookies;
    const cookieSections = cookies.sections.map((sec) => {
      if (sec.type === "flavorList") {
        return `
          <div>
            <h4 class="text-sm font-bold text-[#852c51] mb-2 pb-1" style="margin-top:0; border-bottom-width: 1px !important; border-color: #e5e7eb !important;">${esc(sec.heading)}</h4>
            <div class="space-y-2 text-sm max-w-sm">
              ${flavorQtyRows(sec.options, sec.qtyClass)}
            </div>
          </div>`;
      }
      return `
        <div>
          <h4 class="text-sm font-bold text-[#852c51] mb-2 pb-1" style="margin-top:0; border-bottom-width: 1px !important; border-color: #e5e7eb !important;">${esc(sec.heading)}</h4>
