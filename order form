    const customerInfoHtml = `<div class="mb-4 pb-2 border-gray-300" style="border-bottom-width: 1px !important;"><p style="margin:0;"><strong>Name:</strong> ${esc(name)} | <strong>Phone:</strong> ${esc(phone)}</p><p style="margin:0;"><strong>Pickup/Ship Date:</strong> ${esc(date)} | <strong>Time:</strong> ${esc(time)}</p></div>`;

