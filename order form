            });




            document.querySelectorAll('.sc-row').forEach(row => {

                const qty = row.querySelector('.cookie-batch-qty').value;

                const frost = row.querySelector('.cookie-batch-frosting').value;

                if(qty && frost) pastryLines.push(`${qty}x Sugar Cookies (${frost})`);

            });

            document.querySelectorAll('.dsc-row').forEach(row => {

                const qty = row.querySelector('.cookie-batch-qty').value;

                const frost = row.querySelector('.cookie-batch-frosting').value;

                const notes = row.querySelector('.cookie-batch-notes').value;

                if(qty && frost) pastryLines.push(`${qty}x Decorated Sugar Cookies (${frost}) - Design: "${notes}"`);

            });




            if (pastryLines.length > 0) {

                hasItems = true;

                itemsHtml += `<div><h4 class="font-bold text-[#852c51] mb-1" style="margin-top:0;">Pastries & Cookies</h4><ul class="list-disc pl-5" style="margin:0;">`;

                pastryLines.forEach(l => itemsHtml += `<li>${l}</li>`);

                itemsHtml += `</ul></div>`;

            }

        }




        if (document.getElementById('cat-cakes').checked) {

            let cakeLines = [];

            document.querySelectorAll('.cake-instance').forEach((cake, index) => {

                const size = cake.querySelector('.cake-size').value;

                const flav = cake.querySelector('.cake-flavor').value;

                const frost = cake.querySelector('.cake-frosting').value;

                if (size && flav && frost) {

                    let line = `<strong>Cake ${index+1}:</strong> ${size} ${flav} cake with ${frost}`;

                    

                    if(cake.querySelector('.cake-chk-compote').checked) line += ` | Compote: ${cake.querySelector('.cake-compote').value}`;

                    if(cake.querySelector('.cake-chk-writing').checked) {

                        let wText = cake.querySelector('.cake-writing-text').value;

                        let wColor = cake.querySelector('.cake-writing-color').value;

                        if(wColor.includes('Colored')) wColor = cake.querySelector('.cake-custom-color').value;

                        line += ` | Writing: "${wText}" (${wColor})`;

                    }

                    if(cake.querySelector('.cake-chk-deco').checked) line += ` | Deco: "${cake.querySelector('.cake-deco-text').value}"`;

                    

                    cakeLines.push(line);

                }

            });




            if (cakeLines.length > 0) {

                hasItems = true;

                itemsHtml += `<div class="mt-4"><h4 class="font-bold text-[#852c51] mb-1" style="margin-top:0;">Custom Cakes</h4><ul class="list-none space-y-2" style="margin:0;">`;

                cakeLines.forEach(l => itemsHtml += `<li>${l}</li>`);

                itemsHtml += `</ul></div>`;

            }

        }




        if (document.getElementById('cat-breads').checked) {

            let breadLines = [];

            breadLines.push(...getSimpleItems('.loaf-qty'));

            breadLines.push(...getSimpleItems('.bread-qty'));

            

            document.querySelectorAll('.bagel-row').forEach(row => {

                const qty = row.querySelector('.bagel-batch-qty').value;

                const flav = row.querySelector('.bagel-batch-flavor').value;

                const spread = row.querySelector('.bagel-batch-spread').value;

                if(qty && flav && spread) breadLines.push(`${qty}x ${flav} with ${spread}`);

            });




            if (breadLines.length > 0) {

                hasItems = true;

                itemsHtml += `<div class="mt-4"><h4 class="font-bold text-[#852c51] mb-1" style="margin-top:0;">Breads & Bagels</h4><ul class="list-disc pl-5" style="margin:0;">`;

                breadLines.forEach(l => itemsHtml += `<li>${l}</li>`);

                itemsHtml += `</ul></div>`;

            }

        }




        if (!hasItems) itemsHtml += `<p class="text-red-500 italic" style="margin:0;">No items have been filled out with quantities yet.</p>`;




        content.innerHTML = customerInfoHtml + `<div id="just-the-items">${itemsHtml}</div>`;

        document.getElementById('full-order-details').value = document.getElementById('just-the-items').innerText.trim();

        

        return true;

    }




    window.onRecaptchaExpired = function() {

        const captchaError = document.getElementById('captcha-error');

        if (captchaError) {

            captchaError.textContent = 'Your security check expired. Please check “I’m not a robot” again.';

            captchaError.style.display = 'block';

        }

    };




    function prepareAndSubmit() {

        // Keep the existing honeypot check as an additional spam filter.

        const honeypotVal = document.getElementById('spam-honeypot').value;

        if (honeypotVal !== "") {

            console.warn("Spam submission blocked.");

            showSuccessScreen();

            return;

        }




        const valid = generateReview();

        if (!valid) return;

        const captchaError = document.getElementById('captcha-error');

        const captchaLoaded = typeof grecaptcha !== 'undefined';

        const captchaToken = captchaLoaded ? grecaptcha.getResponse() : '';

        if (!captchaToken) {

            captchaError.textContent = captchaLoaded

                ? 'Please check “I’m not a robot” before submitting your order.'

                : 'Spam protection could not load. Please refresh the page and try again.';

            captchaError.style.display = 'block';

            captchaError.scrollIntoView({ behavior: 'smooth', block: 'center' });

            return;

        }

        captchaError.style.display = 'none';

        const form = document.getElementById('orderForm');

        const formData = new FormData(form);

        formData.set('g-recaptcha-response', captchaToken);

        const urlEncodedData = new URLSearchParams(formData).toString();




        const btn = document.querySelector('button[onclick="prepareAndSubmit()"]');

        btn.innerHTML = 'Sending...';

        btn.disabled = true;




        fetch(form.action, {

            method: 'POST',

            mode: 'no-cors',

            headers: {

                'Content-Type': 'application/x-www-form-urlencoded'

            },

            body: urlEncodedData

        }).then(() => {

            showSuccessScreen();

        }).catch(error => {

            alert("Something went wrong. Please refresh the page and try again.");

            if (

                typeof grecaptcha !== 'undefined' &&

                document.querySelector('.g-recaptcha')

            ) {

                grecaptcha.reset();

            }

            btn.innerHTML = 'Submit Final Order <i class="fas fa-check-circle ml-2"></i>';

            btn.disabled = false;

        });

    }




    function showSuccessScreen() {

        document.getElementById('bakery-form').innerHTML = `

            <div class="p-12 text-center bg-white rounded-2xl shadow-xl border border-gray-100" style="border-width: 1px !important;">

                <i class="fas fa-check-circle text-6xl text-[#4e8ea1] mb-6"></i>

                <h2 class="text-3xl font-bold text-[#852c51] mb-4" style="margin-top:0;">Order Request Received!</h2>

                <p class="text-lg text-gray-600 mb-2" style="margin:0;">Thank you for choosing Sweet Elizabeth's Organics.</p>

                <p class="text-gray-600 mb-6" style="margin:0;">We will review your order and contact you within 2 business days.</p>

                

                <div class="bg-[#fdf2f0] border border-gray-200 p-4 rounded-lg text-sm text-[#852c51] text-left max-w-md mx-auto shadow-inner mt-6" style="border-width: 1px !important;">

                    <strong style="display:block; margin-bottom:0.5rem;"><i class="fas fa-camera text-[#4e8ea1] mr-2"></i>Did you order a custom cake or decorated cookies?</strong>

                    Please email your inspiration photos to <a href="mailto:sweetelizabethscolorado@gmail.com" class="text-[#4e8ea1] font-bold hover:underline">sweetelizabethscolorado@gmail.com</a> so we can match your vision!

                </div>

            </div>

        `;

    }




    window.onload = () => {

        // Log page load time into hidden input for bot-check

        document.getElementById('form-load-time').value = Date.now();




        // Block today and the next two full days for bakery preparation.

        const dateInput = document.getElementById('cust-date');

        if (dateInput) {

            dateInput.min = formatISODate(getEarliestPickupDate());



            const onPickupDateChange = () => applyPickupDateValidation(dateInput, true);

            dateInput.addEventListener('input', onPickupDateChange);

            dateInput.addEventListener('change', onPickupDateChange);

            applyPickupDateValidation(dateInput, false);

        }




        addCakeBuilder();

        addCupcakeBatch();

        addBagelBatch();

    };

</script>
