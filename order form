  /* ---------- Date validation ---------- */
  function parseLocalDate(isoDate) {
    const [year, month, day] = isoDate.split("-").map(Number);
    return new Date(year, month - 1, day);
  }

  function formatISODate(date) {
    const yyyy = date.getFullYear();
    const mm = String(date.getMonth() + 1).padStart(2, "0");
    const dd = String(date.getDate()).padStart(2, "0");
    return `${yyyy}-${mm}-${dd}`;
  }

  function getEarliestPickupDate() {
    const earliest = new Date();
    earliest.setHours(0, 0, 0, 0);
    earliest.setDate(earliest.getDate() + brand.minPickupDaysAhead);
    while (earliest.getDay() === 1) earliest.setDate(earliest.getDate() + 1);
    return earliest;
  }

  function showDateError(message) {
    const errorEl = $("#date-error");
    const dateInput = $("#cust-date");
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.style.display = "block";
    }
    if (dateInput) dateInput.classList.add("date-invalid");
  }

  function clearDateError() {
    const errorEl = $("#date-error");
    const dateInput = $("#cust-date");
    if (errorEl) {
      errorEl.textContent = "";
      errorEl.style.display = "none";
    }
    if (dateInput) {
      dateInput.classList.remove("date-invalid");
      dateInput.setCustomValidity("");
    }
  }

  function validatePickupDate(dateInput) {
    if (!dateInput) return { valid: true, message: "" };
    if (!dateInput.value) return { valid: false, message: "Please choose a pickup date." };

    const pickedDate = parseLocalDate(dateInput.value);
    const earliestDate = getEarliestPickupDate();

    if (pickedDate < earliestDate) {
      return { valid: false, message: "Orders need at least 2 days notice. Please choose a later pickup date." };
    }
    if (pickedDate.getDay() === 1) {
      return { valid: false, message: "Sorry, we're closed on Mondays. Please choose a different pickup date." };
    }
    return { valid: true, message: "" };
  }

  function applyPickupDateValidation(dateInput, showVisibleError) {
    const result = validatePickupDate(dateInput);
    if (!result.valid) {
      dateInput.setCustomValidity(result.message);
      if (showVisibleError) showDateError(result.message);
      return false;
    }
    clearDateError();
    return true;
  }

  /* ---------- Review collection (data-driven) ---------- */
  const PASTRY_QTY_SELECTORS = [
    { selector: ".item-qty", suffix: "" },
    { selector: ".donut-qty", suffix: "Donut" },
    ...MENU.pastries.flavorCards.map((c) => ({ selector: `.${c.qtyClass}`, suffix: c.suffix })),
    ...MENU.pastries.cookies.sections
      .filter((s) => s.type === "flavorList")
      .map((s) => ({ selector: `.${s.qtyClass}`, suffix: s.suffix }))
  ];

  function collectQtyLines(selector, suffix) {
    return $$(selector)
      .filter((input) => input.value && parseInt(input.value, 10) > 0)
      .map((input) => {
        let name = input.getAttribute("data-name") || input.getAttribute("data-flavor");
        if (suffix) name = `${name} ${suffix}`;
        return `${input.value}x ${name}`;
      });
  }

  function collectPastries() {
    if (!$("#cat-pastries")?.checked) return [];
    const lines = [];
    PASTRY_QTY_SELECTORS.forEach(({ selector, suffix }) => {
      lines.push(...collectQtyLines(selector, suffix));
    });

    $$(".cupcake-row").forEach((row) => {
      const qty = $(".cc-qty", row)?.value;
      const flav = $(".cc-flavor", row)?.value;
      const frost = $(".cc-frosting", row)?.value;
      const spr = $(".cc-sprinkles", row)?.value;
      if (qty && flav && frost) lines.push(`${qty}x Cupcakes (${flav} Cake with ${frost} Frosting, ${spr})`);
    });

    $$(".sc-row").forEach((row) => {
      const qty = $(".cookie-batch-qty", row)?.value;
      const frost = $(".cookie-batch-frosting", row)?.value;
      if (qty && frost) lines.push(`${qty}x Sugar Cookies (${frost})`);
    });

    $$(".dsc-row").forEach((row) => {
      const qty = $(".cookie-batch-qty", row)?.value;
      const frost = $(".cookie-batch-frosting", row)?.value;
      const notes = $(".cookie-batch-notes", row)?.value;
      if (qty && frost) lines.push(`${qty}x Decorated Sugar Cookies (${frost}) - Design: "${notes}"`);
    });

    return lines;
  }

  function collectCakes() {
    if (!$("#cat-cakes")?.checked) return [];
    const lines = [];
    $$(".cake-instance").forEach((cake, index) => {
      const size = $(".cake-size", cake)?.value;
      const flav = $(".cake-flavor", cake)?.value;
      const frost = $(".cake-frosting", cake)?.value;
      if (!(size && flav && frost)) return;

      let line = `<strong>Cake ${index + 1}:</strong> ${size} ${flav} cake with ${frost}`;
      if ($(".cake-chk-compote", cake)?.checked) {
        line += ` | Compote: ${$(".cake-compote", cake).value}`;
      }
      if ($(".cake-chk-writing", cake)?.checked) {
        let wText = $(".cake-writing-text", cake).value;
        let wColor = $(".cake-writing-color", cake).value;
        if (wColor.includes("Colored")) wColor = $(".cake-custom-color", cake).value;
        line += ` | Writing: "${wText}" (${wColor})`;
      }
      if ($(".cake-chk-deco", cake)?.checked) {
        line += ` | Deco: "${$(".cake-deco-text", cake).value}"`;
      }
      lines.push(line);
    });
    return lines;
  }

  function collectBreads() {
    if (!$("#cat-breads")?.checked) return [];
    const lines = [
      ...collectQtyLines(".loaf-qty", ""),
      ...collectQtyLines(".bread-qty", "")
    ];
    $$(".bagel-row").forEach((row) => {
      const qty = $(".bagel-batch-qty", row)?.value;
      const flav = $(".bagel-batch-flavor", row)?.value;
      const spread = $(".bagel-batch-spread", row)?.value;
      if (qty && flav && spread) lines.push(`${qty}x ${flav} with ${spread}`);
    });
    return lines;
  }

  window.generateReview = function () {
    const form = $("#orderForm");
    const dateInput = $("#cust-date");

    if (!applyPickupDateValidation(dateInput, true)) {
      dateInput.scrollIntoView({ behavior: "smooth", block: "center" });
      return false;
    }

    if (!form.checkValidity()) {
      const firstInvalid = form.querySelector(":invalid");
      if (firstInvalid) {
        firstInvalid.scrollIntoView({ behavior: "smooth", block: "center" });
        firstInvalid.focus({ preventScroll: true });
      }
      form.reportValidity();
      return false;
    }

    const box = $("#review-box");
    const content = $("#review-content");
    box.classList.remove("hidden");
    box.scrollIntoView({ behavior: "smooth", block: "nearest" });

    const name = $("#cust-name").value || "Not provided";
    const phone = $("#cust-phone").value || "Not provided";
    const date = $("#cust-date").value || "Not provided";
