<script>
    function toggleSection(sectionId, isVisible) {
        const el = document.getElementById(sectionId);
        if (isVisible) el.classList.add('active');
        else el.classList.remove('active');
    }
    function toggleVisibility(divId, isVisible) {
        const el = document.getElementById(divId);
        if (isVisible) {
            el.classList.remove('hidden');
        } else {
            el.classList.add('hidden');
            const inputs = el.querySelectorAll('input[type="number"]');
            inputs.forEach(input => input.value = '');
        }
    }
    function removeElement(btn) { btn.parentElement.remove(); }
    const frostings = ['Vanilla', 'Chocolate', 'Strawberry', 'Lemon', 'Cold Brew Coffee'];
    const cakeFlavors = ['Vanilla', 'Chocolate', 'Lemon', 'Carrot', 'Pumpkin'];
    function addCupcakeBatch() {
        const container = document.getElementById('cupcake-batches');
        const row = document.createElement('div');
        row.className = 'cupcake-row batch-row';
        row.style.cssText = 'border-width: 1px !important; border-color: #e5e7eb !important;';
        let flavorOptions = cakeFlavors.map(f => `<option value="${f}">${f} Cake</option>`).join('');
        let frostingOptions = frostings.map(f => `<option value="${f}">${f} Frosting</option>`).join('');
        row.innerHTML = `
            <input type="number" min="1" placeholder="Qty" class="batch-control qty-input-sm cc-qty">
            <select class="batch-control cc-flavor"><option value="" disabled selected>Cake Flavor...</option>${flavorOptions}</select>
            <select class="batch-control cc-frosting"><option value="" disabled selected>Frosting...</option>${frostingOptions}</select>
            <select class="batch-control cc-sprinkles"><option value="Sprinkles">Yes Sprinkles</option><option value="No Sprinkles">No Sprinkles</option></select>
            <button type="button" onclick="removeElement(this)" class="icon-remove" style="border-width:0 !important; background:transparent;"><i class="fas fa-times"></i></button>
        `;
        container.appendChild(row);
    }
    function addSugarCookieBatch(type) {
        const container = document.getElementById(type === 'Standard' ? 'sugar-cookie-batches' : 'dec-sugar-cookie-batches');
        const row = document.createElement('div');
        row.className = `${type === 'Standard' ? 'sc-row' : 'dsc-row'} batch-row-col`;
        row.style.cssText = 'border-width: 1px !important; border-color: #e5e7eb !important;';
        let frostingOptions = frostings.map(f => `<option value="${f}">${f} Frosting</option>`).join('');
        let html = `
            <div class="batch-row-inline">
                <input type="number" min="1" placeholder="Qty" class="batch-control qty-input-sm cookie-batch-qty">
                <select class="batch-control cookie-batch-frosting"><option value="" disabled selected>Frosting Flavor...</option>${frostingOptions}</select>
            </div>
        `;
        if (type === 'Decorated') html += `<input type="text" placeholder="Design specifications (e.g. Blue flowers)..." class="batch-control-full cookie-batch-notes">`;
        html += `<button type="button" onclick="removeElement(this)" class="icon-remove-top" style="border-width:0 !important; background:transparent;"><i class="fas fa-times"></i></button>`;
        row.innerHTML = html;
        container.appendChild(row);
    }
    function addBagelBatch() {
        const container = document.getElementById('bagel-batches');
        const row = document.createElement('div');
        row.className = 'bagel-row batch-row';
        row.style.cssText = 'border-width: 1px !important;';
        const bagelFlavors = ['Plain', 'Chocolate Chip', 'Cinnamon Sugar'];
        const spreadFlavors = ['Plain Cream Cheese', 'Scallion Cream Cheese', 'Cinnamon Cream Cheese', 'No Spread (Dry)'];
        let bagelOpts = bagelFlavors.map(f => `<option value="${f}">${f} Bagel</option>`).join('');
        let spreadOpts = spreadFlavors.map(f => `<option value="${f}">${f}</option>`).join('');
        row.innerHTML = `
            <input type="number" min="1" placeholder="Qty" class="batch-control qty-input-sm bagel-batch-qty">
            <select class="batch-control bagel-batch-flavor"><option value="" disabled selected>Bagel Flavor...</option>${bagelOpts}</select>
            <select class="batch-control bagel-batch-spread"><option value="" disabled selected>Select Spread...</option>${spreadOpts}</select>
            <button type="button" onclick="removeElement(this)" class="icon-remove" style="border-width:0 !important; background:transparent;"><i class="fas fa-times"></i></button>
        `;
        container.appendChild(row);
    }
    let cakeCounter = 0;
    function addCakeBuilder() {
        cakeCounter++;
        const container = document.getElementById('cake-builders-container');
        const wrapper = document.createElement('div');
        const id = `cake-group-${cakeCounter}`;
        wrapper.className = 'cake-instance';
        wrapper.style.cssText = 'border-width: 1px !important;';
        wrapper.id = id;
        const sizes = ['4" Single Layer (Serves 2-3)', '6" Single Layer (Serves 6)', '6" Double Layer (Serves 12-16)', '8" Single Layer (Serves 8-12)', '8" Double Layer (Serves 24-30)', 'Bundt (Serves 8-12)'];
        const compotes = ['Strawberry', 'Cherry', 'Blueberry', 'Raspberry'];
        const writingFrostings = ['Vanilla (White)', 'Chocolate (Brown)', 'Strawberry (Pink)', 'Lemon (White)', 'Cold Brew (Beige)', 'Colored Vanilla (Muted/Pastel)'];
        wrapper.innerHTML = `
            ${cakeCounter > 1 ? `<button type="button" onclick="document.getElementById('${id}').remove()" class="icon-remove-tr" style="border-width:0 !important; background:transparent;"><i class="fas fa-trash"></i></button>` : ''}
            <h4 class="cake-heading" style="margin-top:0;">Cake #${cakeCounter}</h4>
            <div class="field-grid field-grid-3">
                <div>
                    <label class="field-label-xs">Size *</label>
                    <select class="batch-control-full cake-size">
                        <option value="" disabled selected>Select Size...</option>
                        ${sizes.map(s => `<option value='${s}'>${s}</option>`).join('')}
                    </select>
                </div>
                <div>
                    <label class="field-label-xs">Cake Flavor *</label>
                    <select class="batch-control-full cake-flavor">
                        <option value="" disabled selected>Select Flavor...</option>
                        ${cakeFlavors.map(f => `<option value="${f}">${f}</option>`).join('')}
                    </select>
                </div>
                <div>
                    <label class="field-label-xs">Frosting *</label>
                    <select class="batch-control-full cake-frosting">
                        <option value="" disabled selected>Select Frosting...</option>
                        ${frostings.map(f => `<option value="${f}">${f}</option>`).join('')}
                        <option value="Coconut Whipped Cream">Coconut Whipped Cream (+Fee)(lightly sweetened with syrup)(no coloring option)</option>
                    </select>
                </div>
            </div>
            <div class="cake-options" style="border-top-width: 1px !important; border-color: #e5e7eb !important;">
                <label class="item-check-sm">
                    <input type="checkbox" class="form-checkbox cake-chk-compote" onchange="toggleVisibility('compote-${id}', this.checked)">
                    <span>Add Fruit Compote Filling (+Fee)</span>
                </label>
                <div id="compote-${id}" class="hidden cake-sub">
                    <select class="batch-control cake-compote"><option value="" disabled selected>Select Fruit...</option>${compotes.map(c => `<option value="${c}">${c}</option>`).join('')}</select>
                </div>
                <label class="item-check-sm">
                    <input type="checkbox" class="form-checkbox cake-chk-writing" onchange="toggleVisibility('writing-${id}', this.checked)">
                    <span>Add Writing on Top</span>
                </label>
                <div id="writing-${id}" class="hidden cake-writing-box">
                    <input type="text" placeholder="What should it say?" class="batch-control-full cake-writing-text">
                    <select class="batch-control-full cake-writing-color" onchange="toggleVisibility('custom-color-${id}', this.value.includes('Colored'))">
                        <option value="" disabled selected>Select Frosting Color for Writing...</option>
                        ${writingFrostings.map(f => `<option value="${f}">${f}</option>`).join('')}
                    </select>
                    <input type="text" id="custom-color-${id}" placeholder="Specify Pastel/Muted Color..." class="hidden batch-control-full cake-custom-color">
                </div>
                <label class="item-check-sm">
                    <input type="checkbox" class="form-checkbox cake-chk-deco" onchange="toggleVisibility('deco-${id}', this.checked)">
                    <span>Add Other Decorations (+Fee)</span>
                </label>
                <div id="deco-${id}" class="hidden cake-sub">
                    <textarea placeholder="Describe decorations..." class="batch-control-full cake-deco-text" rows="2"></textarea>
                </div>
                <div class="design-note" style="border-width: 1px !important;">
                    <i class="fas fa-camera icon-gap"></i><strong>Have a specific design?</strong> Please email your inspiration photos to sweetelizabethscolorado@gmail.com after submitting your order!
                </div>
            </div>
        `;
        container.appendChild(wrapper);
        // Restriction: 4" cakes cannot have fruit compote filling or additional decorations.
        const sizeSelect = wrapper.querySelector('.cake-size');
        sizeSelect.addEventListener('change', function() {
            const is4Inch = sizeSelect.value.startsWith('4"');
            const compoteChk = wrapper.querySelector('.cake-chk-compote');
            const decoChk = wrapper.querySelector('.cake-chk-deco');
            compoteChk.disabled = is4Inch;
            compoteChk.closest('label').classList.toggle('opacity-50', is4Inch);
            if (is4Inch && compoteChk.checked) {
                compoteChk.checked = false;
                toggleVisibility(`compote-${id}`, false);
            }
            decoChk.disabled = is4Inch;
            decoChk.closest('label').classList.toggle('opacity-50', is4Inch);
            if (is4Inch && decoChk.checked) {
                decoChk.checked = false;
                toggleVisibility(`deco-${id}`, false);
            }
        });
    }
    const MIN_PICKUP_DAYS_AHEAD = 3;
    function parseLocalDate(isoDate) {
        const [year, month, day] = isoDate.split('-').map(Number);
        return new Date(year, month - 1, day);
    }
    function formatISODate(date) {
        const yyyy = date.getFullYear();
        const mm = String(date.getMonth() + 1).padStart(2, '0');
        const dd = String(date.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }
    function getEarliestPickupDate() {
        const earliest = new Date();
        earliest.setHours(0, 0, 0, 0);
        earliest.setDate(earliest.getDate() + MIN_PICKUP_DAYS_AHEAD);
        while (earliest.getDay() === 1) earliest.setDate(earliest.getDate() + 1);
        return earliest;
    }
    function showDateError(message) {
        const errorEl = document.getElementById('date-error');
        const dateInput = document.getElementById('cust-date');
        if (errorEl) {
            errorEl.textContent = message;
            errorEl.style.display = 'block';
        }
        if (dateInput) dateInput.classList.add('date-invalid');
    }
    function clearDateError() {
        const errorEl = document.getElementById('date-error');
        const dateInput = document.getElementById('cust-date');
        if (errorEl) {
            errorEl.textContent = '';
            errorEl.style.display = 'none';
        }
        if (dateInput) {
            dateInput.classList.remove('date-invalid');
            dateInput.setCustomValidity('');
        }
    }
    function validatePickupDate(dateInput) {
        if (!dateInput) return { valid: true, message: '' };
        if (!dateInput.value) {
            return { valid: false, message: 'Please choose a pickup date.' };
        }
        const pickedDate = parseLocalDate(dateInput.value);
        const earliestDate = getEarliestPickupDate();
        if (pickedDate < earliestDate) {
            return { valid: false, message: 'Orders need at least 2 days notice. Please choose a later pickup date.' };
        }
        if (pickedDate.getDay() === 1) {
            return { valid: false, message: "Sorry, we're closed on Mondays. Please choose a different pickup date." };
        }
        return { valid: true, message: '' };
    }
    function applyPickupDateValidation(dateInput, showVisibleError) {
        const result = validatePickupDate(dateInput);
        if (!result.valid) {
            dateInput.setCustomValidity(result.message);
            if (showVisibleError) showDateError(result.message);
            return false;
        }
        clearDateError();
        return true;
    }
    function generateReview() {
        const form = document.getElementById('orderForm');
        const dateInput = document.getElementById('cust-date');
        if (!applyPickupDateValidation(dateInput, true)) {
            dateInput.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        if (!form.checkValidity()) {
            const firstInvalid = form.querySelector(':invalid');
            if (firstInvalid) {
                firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
                firstInvalid.focus({ preventScroll: true });
            }
            form.reportValidity();
            return false;
        }
        const box = document.getElementById('review-box');
        const content = document.getElementById('review-content');
        box.classList.remove('hidden');
        box.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        let customerInfoHtml = '';
        let itemsHtml = '';
        const name = document.getElementById('cust-name').value || 'Not provided';
        const phone = document.getElementById('cust-phone').value || 'Not provided';
        const date = document.getElementById('cust-date').value || 'Not provided';
        const time = document.getElementById('cust-time').value || 'Not provided';
        customerInfoHtml = `<div class="review-customer" style="border-bottom-width: 1px !important;"><p style="margin:0;"><strong>Name:</strong> ${name} | <strong>Phone:</strong> ${phone}</p><p style="margin:0;"><strong>Pickup/Ship Date:</strong> ${date} | <strong>Time:</strong> ${time}</p></div>`;
        let hasItems = false;
        const getSimpleItems = (selector, suffix = "") => {
            let items = [];
            document.querySelectorAll(selector).forEach(input => {
                if (input.value && parseInt(input.value) > 0) {
                    let itemName = input.getAttribute('data-name') || input.getAttribute('data-flavor');
                    if (suffix) itemName = `${itemName} ${suffix}`;
                    items.push(`${input.value}x ${itemName}`);
                }
            });
            return items;
        };
        if (document.getElementById('cat-pastries').checked) {
            let pastryLines = [];
            pastryLines.push(...getSimpleItems('.item-qty'));
            pastryLines.push(...getSimpleItems('.donut-qty', 'Donut'));
            pastryLines.push(...getSimpleItems('.turnover-qty', 'Turnover'));
            pastryLines.push(...getSimpleItems('.scone-qty', 'Scone'));
            pastryLines.push(...getSimpleItems('.muffin-qty', 'Banana Muffin'));
            pastryLines.push(...getSimpleItems('.coffee-qty', 'Coffee Cake'));
            pastryLines.push(...getSimpleItems('.cookie-qty', 'Cookie'));
            pastryLines.push(...getSimpleItems('.minicookie-qty', 'Bag'));
            document.querySelectorAll('.cupcake-row').forEach(row => {
                const qty = row.querySelector('.cc-qty').value;
                const flav = row.querySelector('.cc-flavor').value;
                const frost = row.querySelector('.cc-frosting').value;
                const spr = row.querySelector('.cc-sprinkles').value;
                if(qty && flav && frost) pastryLines.push(`${qty}x Cupcakes (${flav} Cake with ${frost} Frosting, ${spr})`);
            });
            document.querySelectorAll('.sc-row').forEach(row => {
                const qty = row.querySelector('.cookie-batch-qty').value;
                const frost = row.querySelector('.cookie-batch-frosting').value;
                if(qty && frost) pastryLines.push(`${qty}x Sugar Cookies (${frost})`);
            });
            document.querySelectorAll('.dsc-row').forEach(row => {
                const qty = row.querySelector('.cookie-batch-qty').value;
                const frost = row.querySelector('.cookie-batch-frosting').value;
                const notes = row.querySelector('.cookie-batch-notes').value;
                if(qty && frost) pastryLines.push(`${qty}x Decorated Sugar Cookies (${frost}) - Design: "${notes}"`);
            });
            if (pastryLines.length > 0) {
                hasItems = true;
                itemsHtml += `<div><h4 class="review-group-title" style="margin-top:0;">Pastries & Cookies</h4><ul class="review-list" style="margin:0;">`;
                pastryLines.forEach(l => itemsHtml += `<li>${l}</li>`);
                itemsHtml += `</ul></div>`;
            }
        }
        if (document.getElementById('cat-cakes').checked) {
            let cakeLines = [];
            document.querySelectorAll('.cake-instance').forEach((cake, index) => {
                const size = cake.querySelector('.cake-size').value;
                const flav = cake.querySelector('.cake-flavor').value;
                const frost = cake.querySelector('.cake-frosting').value;
                if (size && flav && frost) {
                    let line = `<strong>Cake ${index+1}:</strong> ${size} ${flav} cake with ${frost}`;
                    if(cake.querySelector('.cake-chk-compote').checked) line += ` | Compote: ${cake.querySelector('.cake-compote').value}`;
                    if(cake.querySelector('.cake-chk-writing').checked) {
                        let wText = cake.querySelector('.cake-writing-text').value;
                        let wColor = cake.querySelector('.cake-writing-color').value;
                        if(wColor.includes('Colored')) wColor = cake.querySelector('.cake-custom-color').value;
                        line += ` | Writing: "${wText}" (${wColor})`;
                    }
                    if(cake.querySelector('.cake-chk-deco').checked) line += ` | Deco: "${cake.querySelector('.cake-deco-text').value}"`;
                    cakeLines.push(line);
                }
            });
            if (cakeLines.length > 0) {
                hasItems = true;
                itemsHtml += `<div class="review-spacer"><h4 class="review-group-title" style="margin-top:0;">Custom Cakes</h4><ul class="review-list-plain" style="margin:0;">`;
                cakeLines.forEach(l => itemsHtml += `<li>${l}</li>`);
                itemsHtml += `</ul></div>`;
            }
        }
        if (document.getElementById('cat-breads').checked) {
            let breadLines = [];
            breadLines.push(...getSimpleItems('.loaf-qty'));
            breadLines.push(...getSimpleItems('.bread-qty'));
            document.querySelectorAll('.bagel-row').forEach(row => {
                const qty = row.querySelector('.bagel-batch-qty').value;
                const flav = row.querySelector('.bagel-batch-flavor').value;
                const spread = row.querySelector('.bagel-batch-spread').value;
                if(qty && flav && spread) breadLines.push(`${qty}x ${flav} with ${spread}`);
            });
            if (breadLines.length > 0) {
                hasItems = true;
                itemsHtml += `<div class="review-spacer"><h4 class="review-group-title" style="margin-top:0;">Breads & Bagels</h4><ul class="review-list" style="margin:0;">`;
                breadLines.forEach(l => itemsHtml += `<li>${l}</li>`);
                itemsHtml += `</ul></div>`;
            }
        }
        if (!hasItems) itemsHtml += `<p class="review-empty" style="margin:0;">No items have been filled out with quantities yet.</p>`;
        content.innerHTML = customerInfoHtml + `<div id="just-the-items">${itemsHtml}</div>`;
        document.getElementById('full-order-details').value = document.getElementById('just-the-items').innerText.trim();
        return true;
    }
    window.onRecaptchaExpired = function() {
        const captchaError = document.getElementById('captcha-error');
        if (captchaError) {
            captchaError.textContent = 'Your security check expired. Please check “I’m not a robot” again.';
            captchaError.style.display = 'block';
        }
    };
    function prepareAndSubmit() {
        // Keep the existing honeypot check as an additional spam filter.
        const honeypotVal = document.getElementById('spam-honeypot').value;
        if (honeypotVal !== "") {
            console.warn("Spam submission blocked.");
            showSuccessScreen();
            return;
        }
        const valid = generateReview();
        if (!valid) return;
        const captchaError = document.getElementById('captcha-error');
        const captchaLoaded = typeof grecaptcha !== 'undefined';
        const captchaToken = captchaLoaded ? grecaptcha.getResponse() : '';
        if (!captchaToken) {
            captchaError.textContent = captchaLoaded
                ? 'Please check “I’m not a robot” before submitting your order.'
                : 'Spam protection could not load. Please refresh the page and try again.';
            captchaError.style.display = 'block';
            captchaError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        captchaError.style.display = 'none';
        const form = document.getElementById('orderForm');
        const formData = new FormData(form);
        formData.set('g-recaptcha-response', captchaToken);
        const urlEncodedData = new URLSearchParams(formData).toString();
        const btn = document.querySelector('button[onclick="prepareAndSubmit()"]');
        btn.innerHTML = 'Sending...';
        btn.disabled = true;
        fetch(form.action, {
            method: 'POST',
            mode: 'no-cors',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: urlEncodedData
        }).then(() => {
            showSuccessScreen();
        }).catch(error => {
            alert("Something went wrong. Please refresh the page and try again.");
            if (
                typeof grecaptcha !== 'undefined' &&
                document.querySelector('.g-recaptcha')
            ) {
                grecaptcha.reset();
            }
            btn.innerHTML = 'Submit Final Order <i class="fas fa-check-circle icon-gap-left"></i>';
            btn.disabled = false;
        });
    }
    function showSuccessScreen() {
        document.getElementById('bakery-form').innerHTML = `
            <div class="success-screen" style="border-width: 1px !important;">
                <i class="fas fa-check-circle success-icon"></i>
                <h2 class="success-title" style="margin-top:0;">Order Request Received!</h2>
                <p class="success-text" style="margin:0;">Thank you for choosing Sweet Elizabeth's Organics.</p>
                <p class="success-text-sm" style="margin:0;">We will review your order and contact you within 2 business days.</p>
                <div class="success-note" style="border-width: 1px !important;">
                    <strong style="display:block; margin-bottom:0.5rem;"><i class="fas fa-camera icon-blue"></i>Did you order a custom cake or decorated cookies?</strong>
                    Please email your inspiration photos to <a href="mailto:sweetelizabethscolorado@gmail.com" class="mail-link">sweetelizabethscolorado@gmail.com</a> so we can match your vision!
                </div>
            </div>
        `;
    }
    window.onload = () => {
        // Log page load time into hidden input for bot-check
        document.getElementById('form-load-time').value = Date.now();
        // Block today and the next two full days for bakery preparation.
        const dateInput = document.getElementById('cust-date');
        if (dateInput) {
            dateInput.min = formatISODate(getEarliestPickupDate());
            const onPickupDateChange = () => applyPickupDateValidation(dateInput, true);
            dateInput.addEventListener('input', onPickupDateChange);
            dateInput.addEventListener('change', onPickupDateChange);
            applyPickupDateValidation(dateInput, false);
        }
        addCakeBuilder();
        addCupcakeBatch();
        addBagelBatch();
    };
</script>
